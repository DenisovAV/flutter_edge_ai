.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/.flutter-plugins-dependencies
.DS_Store
trash_*
.env
# Fork note: upstream ignores docs/* except LEGACY_API.md and the published
# benchmark. This fork tracks docs/ for project documentation (see docs/README.md).
# Upstream's unpublished benchmark scratch files stay ignored.
docs/benchmarks/*
!docs/benchmarks/rag_sqlite_vec_vs_qdrant.md
.claude/settings.local.json

# Backup files
*.old
*.backup

# IDE files
.idea/

# Melos-generated IntelliJ project files (regenerated on `melos bootstrap`)
melos_*.iml

# Test coverage
coverage/

# Sensitive configuration files
**/example/config.json

# Flutter build artifacts
build/
devtools_options.yaml

# Gradle's per-project state: file-hash caches, .lock files, last-build.bin.
# Only packages/flutter_gemma/android/ carried a .gitignore for this, so a
# local Gradle run in any OTHER package's android/ dir left 8 tracked binaries
# behind — which is exactly how they reached a PR, and they would have shipped
# in the next flutter_gemma_mediapipe archive (that package has no .pubignore).
**/.gradle/
**/local.properties

# NPM files in the repo root — the web bundle build lives in
# packages/flutter_gemma_litertlm/tool/web_build, never here.
/package.json
/package-lock.json
/vite.config.js

# Node modules
node_modules/

# Generated/downloaded models
**/example/web/models/
**/example/web/wasm/
**/example/web/*.model

# Local RAG fixtures (Gecko + EmbeddingGemma) — pulled by maintainer for
# integration tests, never committed (~300 MB).
**/example/assets/test/*.tflite
**/example/assets/test/*.model

# Desktop - cached/extracted JRE (downloaded at build time)
**/example/macos/jre/
**/jre/

# Desktop - large JAR files (built/downloaded at build time)
**/macos/Resources/litertlm-server.jar
**/litertlm-server.jar

# Desktop - TFLite C library (downloaded at build time)
**/macos/Resources/tflite/libtensorflowlite_c.dylib

# Temporary/internal documentation
temporary_docs/
DESKTOP_DEBUG.md

# Test reports and review artifacts
test_reports/

# Investigation scripts
**/example/scripts/

docs/plans

# LLVM coverage drift
*.profraw

# Working notes (drafts, plans, articles, investigation reports)
_notes/

# Misc
firebase-debug.log
tables.html
test_audio.txt
ai-edge-gallery/
# Note: colabs/*.ipynb are tracked in repo (training notebooks) but
# excluded from pub package via .pubignore.

.remember/

# Native prebuilts — built locally / fetched from native-v* GitHub Release
# by hook/build.dart. Maintainers populate via native/litert_lm/build_*.sh
# scripts, then upload to a native-v<X> GitHub Release tag; consumers
# fetch from there at `pub get` time. Not tracked in git to keep clones
# lean (each set is ~350 MB across all platforms).
**/native/litert_lm/prebuilt/
**/native/sqlite_vec/prebuilt/

# Local chromedriver (puppeteer browsers install) — used by web integration tests
/chromedriver/
/.drafts/

# Swift Package Manager build cache (per-plugin ios/macos Package.swift), like Pods/
**/.build/

# Python bytecode from .claude/hooks (would keep the publish guard's dirty-tree check permanently non-empty)
__pycache__/
*.pyc

# Flutter crash reports — one got committed into a package and shipped to
# pub.dev inside flutter_gemma_litertlm 1.8.0.
flutter_*.log

# --- Motormind (fork) ---------------------------------------------------------
# FVM's SDK link and cache; .fvmrc stays tracked.
.fvm/
# Pure-Dart package lockfiles are regenerated by `dart pub get`.
apps/motormind/packages/*/pubspec.lock
