# Files and directories to exclude from pub.dev package
docs/
.github/
.idea/
.vscode/
.claude/
test_reports/
**/*.md
!README.md
!CHANGELOG.md
tools/

# Build artifacts
build/
coverage/
devtools_options.yaml

# NPM files (should not be in pub package)
node_modules/
package-lock.json
# Top-level package.json / vite.config.js (none in current repo, but
# protect against future accidental add). The web bundle is no longer built
# here: its source moved to flutter_edge_ai_litertlm/tool/web_build, next to
# the web/ directory that ships its output.
/package.json
/vite.config.js

# Vite build artifacts (generated files with hashes)
web/*.js
web/*.js.map
# But keep cache_api.js (hand-written, runtime needs window.cacheHas/Put/Get)
!web/cache_api.js
# And opfs_helper.js — defines window.flutterGemmaOPFS, which web streaming
# storage (WebStorageMode.streaming) binds to. Without this line it never
# reached pub, so the documented copy-from-the-package step had nothing to copy.
!web/opfs_helper.js

# Media files (for README, not needed in package)
docs/
assets/
colabs/
training_data/

# IDE files
*.iml

# Example app model files
example/assets/models/

# Local RAG fixtures (Gecko + EmbeddingGemma) — maintainer-pulled for
# integration tests, ~300 MB, never shipped in pub package.
example/assets/test/*.tflite
example/assets/test/*.model

# Example scripts (for local test setup, not needed in package)
example/scripts/

# Test files
test/
example/build/
example/.dart_tool/
example/.idea/
example/coverage/

# Example web build artifacts (should be regenerated by users)
example/web/models/
example/web/wasm/
example/web/*.js
example/web/*.wasm
# ...and the wasm one level deeper: the `*` above does not cross a `/`, so this
# 800 KB binary rode along in every release. It belongs to
# flutter_edge_ai_sqlite — which ships its own copy, and is where the docs
# send you — and here it is read only by example/integration_test/, which this
# file already excludes.
example/web/rag/
example/web/*.model
!example/web/index.html
!example/web/manifest.json
!example/web/favicon.png
!example/web/icons/

# Log files
*.log
firebase-debug.log
litertlm-server/hs_err_*.log

# Desktop - TFLite C library (downloaded at build time)
macos/Resources/tflite/

# Desktop - JAR (downloaded at build time via prepare_resources.sh)
macos/Resources/litertlm-server.jar
litertlm-server/litertlm-server.jar
**/*.jar

# Misc
test_exports.dart
trash_*
.env
.firecrawl/
example/kill

# Native prebuilts — fetched by hook/build.dart from native-v0.10.2 release
native/litert_lm/prebuilt/

# Training/conversion notebooks — useful for plugin dev, not for users
colabs/

# Integration tests (kept in repo for dev, not for users)
example/integration_test/

# LLVM coverage
*.profraw

# Working notes (drafts, plans, articles, investigation reports)
_notes/

# Native FFI smoke-test — compiled into a standalone binary by maintainers
# during dev, not loaded at runtime. End users don't need the .c source.
native/litert_lm/test_ffi_minimal.c

# Stray maintainer scratch files. tables.html is leftover Mac/HTML debug
# from a much older session; test_audio.txt is a 53-byte text fixture
# that's only referenced by integration tests (already excluded above).
tables.html
test_audio.txt

# Reference clone of google-ai-edge/gallery used during research — this
# is third-party Apache 2.0 source (Google's), not part of flutter_edge_ai.
# Should never be in the pub package.
ai-edge-gallery/

# CocoaPods lock files — environment-specific, regenerated on every
# `pod install`. pub.dev's lints flag these.
example/ios/Podfile.lock
example/macos/Podfile.lock

# Example web test HTML fixture (used by vector store dev tests).
example/web/test_vectorstore.html

# chromedriver binary — maintainer tool for running web integration tests
# (flutter drive -d chrome). ~16 MB, not part of the plugin. Without this
# it leaks into the pub package and bloats it (8 MB → archive).
chromedriver/

# Agent skills MUST ship inside the archive — `dart run skills@ get` resolves
# the package on disk from package_config.json and reads `skills/` from there.
# Without this exception the blanket `**/*.md` above silently strips every
# SKILL.md and the skills reach nobody, with no error anywhere.
#
# It is LAST on purpose: the last matching rule wins, and rules such as
# `assets/`, `docs/` and `test/` would otherwise drop a skill subdirectory with
# those names — `assets/` is part of the Agent Skills layout.
!skills/
!skills/**
