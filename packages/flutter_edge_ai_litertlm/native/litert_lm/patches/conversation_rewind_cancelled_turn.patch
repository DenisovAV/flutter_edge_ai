+LiteRtLmStatusCode litert_lm_conversation_rewind_cancelled_turn(
+    LiteRtLmConversation* conversation, const char* messages_json,
+    const char* extra_context,
+    const LiteRtLmConversationOptionalArgs* optional_args,
+    int* out_last_turn_end) {
+  if (out_last_turn_end) *out_last_turn_end = kLiteRtLmTurnEndNone;
+  if (!conversation || !conversation->conversation) {
+    return litert::lm::c::ReturnError(absl::StatusCode::kInvalidArgument,
+                                      "Invalid conversation.");
+  }
+  std::optional<litert::lm::Message> stopped_exchange;
+  if (messages_json) {
+    auto json = nlohmann::ordered_json::parse(messages_json, /*cb=*/nullptr,
+                                              /*allow_exceptions=*/false);
+    if (json.is_discarded()) {
+      return litert::lm::c::ReturnError(absl::StatusCode::kInvalidArgument,
+                                        "Failed to parse messages JSON.");
+    }
+    stopped_exchange = std::move(json);
+  }
+
+  // The stop may not have reached the running task yet (a caller that stopped
+  // listening without waiting), and its callbacks may still be queued: cancel
+  // again, then wait until every task has ended. Only then is the recorded end
+  // final, and only then has the cancel callback removed the stopped message.
+  conversation->conversation->CancelProcess();
+  absl::Status waited = conversation->conversation->WaitUntilDone();
+  int end;
+  {
+    std::lock_guard<std::mutex> lock(conversation->turn_mutex);
+    end = waited.ok() ? conversation->last_turn_end : kLiteRtLmTurnEndRunning;
+  }
+  if (out_last_turn_end) *out_last_turn_end = end;
+  if (!waited.ok()) {
+    return litert::lm::c::ToCStatus(waited);
+  }
+  if (end == kLiteRtLmTurnEndNone || end == kLiteRtLmTurnEndCompleted) {
+    return kLiteRtLmStatusOk;
+  }
+  if (end != kLiteRtLmTurnEndCancelled) {
+    return litert::lm::c::ReturnError(
+        absl::StatusCode::kInternal,
+        "The last turn failed; the conversation cannot continue.");
+  }
+
+  absl::Status status = conversation->conversation->RewindCancelledTurn(
+      stopped_exchange,
+      CreateOptionalArgs(conversation->conversation.get(), extra_context,
+                         optional_args));
+  if (!status.ok()) {
+    ABSL_LOG(ERROR) << "Failed to rewind the cancelled turn: " << status;
+    return litert::lm::c::ToCStatus(status);
+  }
+  {
+    std::lock_guard<std::mutex> lock(conversation->turn_mutex);
+    conversation->last_turn_end = kLiteRtLmTurnEndNone;
+  }
+  return kLiteRtLmStatusOk;
+}
