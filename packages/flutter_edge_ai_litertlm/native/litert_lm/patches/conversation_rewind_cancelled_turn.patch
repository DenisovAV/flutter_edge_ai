+absl::Status Conversation::RewindCancelledTurn(
+    const std::optional<Message>& stopped_exchange,
+    const OptionalArgs& optional_args) {
+  if (stopped_exchange.has_value() &&
+      (!stopped_exchange->is_array() || stopped_exchange->empty())) {
+    return absl::InvalidArgumentError(
+        "The stopped exchange must be a non-empty JSON array of messages.");
+  }
+  if (!config_.enable_rewinding()) {
+    return absl::UnimplementedError(
+        "Rewinding is disabled for this conversation.");
+  }
+  {
+    absl::MutexLock lock(history_mutex_);
+    if (!last_turn_cancelled_) {
+      return absl::FailedPreconditionError("The last turn was not cancelled.");
+    }
+    if (!turn_checkpoint_saved_) {
+      return absl::NotFoundError(
+          turn_checkpoint_error_.ok()
+              ? std::string("The last turn was cancelled before its own "
+                            "prefill was scheduled.")
+              : absl::StrCat("The last turn's checkpoint was not saved: ",
+                             turn_checkpoint_error_.ToString()));
+    }
+    // One rewind per cancelled turn.
+    last_turn_cancelled_ = false;
+    turn_checkpoint_saved_ = false;
+  }
+  ABSL_RETURN_IF_ERROR(session_->RewindToCheckpoint(kTurnStartCheckpoint));
+
+  std::vector<Message> old_messages;
+  {
+    absl::MutexLock lock(history_mutex_);
+    // The cancel callback removed the message; these two still describe the
+    // cancelled send.
+    checkpoint_message_index_ = turn_checkpoint_message_index_;
+    channel_content_since_last_user_message_ =
+        turn_channel_content_since_last_user_message_;
+    if (!stopped_exchange.has_value()) {
+      return absl::OkStatus();
+    }
+    old_messages = history_;
+  }
+
+  std::vector<Message> new_messages(stopped_exchange->begin(),
+                                    stopped_exchange->end());
+  ABSL_ASSIGN_OR_RETURN(
+      std::string prefill_text,
+      GetPrefillTextForMessages(
+          old_messages, new_messages, optional_args,
+          /*include_preface=*/!config_.prefill_preface_on_init()));
+  // When the history is empty the text carries the preface, so its messages
+  // are converted too, as on the first send: their media fills placeholders.
+  nlohmann::ordered_json messages_for_conversion =
+      nlohmann::ordered_json::array();
+  if (old_messages.empty() && !config_.prefill_preface_on_init() &&
+      std::holds_alternative<JsonPreface>(preface_)) {
+    const auto& preface_messages = std::get<JsonPreface>(preface_).messages;
+    if (preface_messages.is_array()) {
+      for (const auto& message : preface_messages) {
+        messages_for_conversion.push_back(message);
+      }
+    } else if (!preface_messages.is_null()) {
+      messages_for_conversion.push_back(preface_messages);
+    }
+  }
+  for (const auto& message : new_messages) {
+    messages_for_conversion.push_back(message);
+  }
+  ABSL_ASSIGN_OR_RETURN(
+      std::vector<InputData> session_inputs,
+      model_data_processor_->ToInputDataVector(
+          prefill_text, messages_for_conversion,
+          optional_args.args.value_or(std::monostate())));
+
+  // RunPrefill() reports a cancelled or failed task as OK; read its state. On
+  // the heap: after a timed-out wait the callback can still run.
+  auto prefill_status = std::make_shared<absl::Status>();
+  ABSL_ASSIGN_OR_RETURN(
+      auto task_controller,
+      session_->RunPrefillAsync(
+          session_inputs,
+          [prefill_status](absl::StatusOr<Responses> responses) {
+            if (!responses.ok()) {
+              *prefill_status = responses.status();
+            } else if (IsTaskEndState(responses->GetTaskState()) &&
+                       responses->GetTaskState() != TaskState::kDone) {
+              *prefill_status = absl::InternalError(
+                  absl::StrCat("Prefill ended with task state: ",
+                               TaskStateToString(responses->GetTaskState())));
+            }
+          }));
+  ABSL_RETURN_IF_ERROR(task_controller->WaitUntilDone(Engine::kDefaultTimeout));
+  ABSL_RETURN_IF_ERROR(*prefill_status);
