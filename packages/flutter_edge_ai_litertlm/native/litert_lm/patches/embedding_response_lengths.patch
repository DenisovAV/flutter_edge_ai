+// flutter_edge_ai patch section 14.
+LiteRtLmStatusCode litert_lm_embedding_response_get_input_length(
+    const LiteRtLmEmbeddingResponse* response, int* out_input_length) {
+  LITERT_LM_C_RETURN_IF_NULL(out_input_length);
+  LITERT_LM_C_RETURN_IF_NULL(response);
