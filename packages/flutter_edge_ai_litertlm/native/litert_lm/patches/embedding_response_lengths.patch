+  return kLiteRtLmStatusOk;
+}
+
+// flutter_edge_ai patch section 14.
+LiteRtLmStatusCode litert_lm_embedding_response_get_truncated_length(
+    const LiteRtLmEmbeddingResponse* response, int* out_truncated_length) {
+  LITERT_LM_C_RETURN_IF_NULL(out_truncated_length);
+  LITERT_LM_C_RETURN_IF_NULL(response);
+  *out_truncated_length = response->response.truncated_length.value_or(0);
+  return kLiteRtLmStatusOk;
+}
