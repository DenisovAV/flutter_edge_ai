+// @param response The response to inspect.
+// @param out_input_length On success, receives the input length in tokens.
+// @return kLiteRtLmStatusOk on success, or kLiteRtLmStatusInvalidArgument if
+//   `response` or `out_input_length` is NULL.
+//
+// Added by flutter_edge_ai patch section 14.
+LITERT_LM_C_API_EXPORT
