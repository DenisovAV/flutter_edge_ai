@@ -2016,6 +2016,19 @@ absl::Status LlmLiteRtCompiledModelExecutorStatic::Prefill(
   // Reduce the input ids only with one user selected.
   auto input_length = ids.size() / input_batch_size;
   ids = ids.subspan(kTokenIndexToReduce * input_length, input_length);
+  // flutter_edge_ai (patch_c_api.sh section 25): a prefill into an empty
+  // context starts the convolution / recurrent state of a hybrid model (LFM2)
+  // from zero. Reset() and a new session only move the step to 0, which is
+  // enough for a KV cache (masked by position) but left the previous
+  // conversation's linear attention state in place: every conversation after
+  // the first on one engine answered differently.
+  if (llm_context_->runtime_state().current_step == 0 &&
+      llm_context_->processed_context().processed_tokens().TokenCount() == 0) {
+    ABSL_RETURN_IF_ERROR(state_->ClearLinearAttentionState());
+    if (decode_state_ != nullptr) {
+      ABSL_RETURN_IF_ERROR(decode_state_->ClearLinearAttentionState());
+    }
+  }
   int remaining_capacity =
       state_->GetNumEntries() - llm_context_->runtime_state().current_step;
 
