+bool LiteRtDispatchInvocationContextT::TryReleaseImported() {
+  if (!use_mutex_.try_lock()) return false;
+  const bool locked = import_mutex_.try_lock();
+  if (locked) {
+    ReleaseImportedLocked();
+    import_mutex_.unlock();
