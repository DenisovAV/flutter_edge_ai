+    if (sp.piece().find('\0') != absl::string_view::npos &&
+        (use_reserved_id_map ||
+         sp.type() == ModelProto::SentencePiece::USER_DEFINED)) {
       status_ = absl::InternalError("piece must not include null character.");
       return;
     }
