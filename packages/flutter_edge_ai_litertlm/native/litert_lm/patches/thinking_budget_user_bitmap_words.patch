+    // memory.
+    const uint64_t* user_words = bitmap.words().data();
+    const size_t num_words = (static_cast<size_t>(vocab_size_) + 63) / 64;
+    std::vector<uint64_t> words(user_words, user_words + num_words);
     words[start_token / 64] |= (uint64_t{1} << (start_token % 64));
