+// The step-0 copy of a bitmap user mask takes the words the vocabulary needs
+// from words().data(), never words().size() or end(), which a prebuilt
+// provider built against another C++ standard library lays out differently
+// (flutter_edge_ai, patch_c_api.sh section 26). A mask holding more words than
+// its vocabulary needs shows which one was read.
+class OversizedBitmapConstraint : public FakeConstraint {
+ public:
+  explicit OversizedBitmapConstraint(int vocabulary_size)
+      : FakeConstraint(/*token_ids=*/{7, 1}, vocabulary_size) {}
+  absl::StatusOr<std::unique_ptr<LogitMask>> ComputeMask(
+      const State&) const override {
+    // Token 7 allowed; three extra words past the vocabulary, all ones.
+    std::vector<uint64_t> words((GetVocabularySize() + 63) / 64 + 3,
+                                ~uint64_t{0});
+    for (size_t i = 0; i < (GetVocabularySize() + 63) / 64; ++i) words[i] = 0;
+    words[0] = uint64_t{1} << 7;
+    return std::make_unique<BitmapLogitMask>(GetVocabularySize(),
+                                             std::move(words));
+  }
+};
+
+TEST(ThinkingBudgetConstraintTest, TestStepZeroCopiesOnlyTheVocabularyWords) {
+  OversizedBitmapConstraint user_constraint(/*vocabulary_size=*/100);
+  ThinkingBudgetConstraint constraint(&user_constraint, /*budget=*/5,
+                                      /*start_token_ids=*/{2, 3},
+                                      /*end_token_ids=*/{4},
+                                      /*vocab_size=*/100);
+  auto state = constraint.Start();
+  ASSERT_OK_AND_ASSIGN(auto mask, constraint.ComputeMask(*state));
+  ASSERT_EQ(mask->GetType(), MaskType::kBitmap);
+  const auto& bitmap = static_cast<const BitmapLogitMask&>(*mask);
+  EXPECT_EQ(bitmap.words().size(), 2u);
+  EXPECT_THAT(AllowedTokens(constraint, *state), ElementsAre(2, 7));
+}
