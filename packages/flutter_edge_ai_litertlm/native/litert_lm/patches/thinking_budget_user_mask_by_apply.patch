+// A mask that reports kBitmap but is not this runtime's BitmapLogitMask, as a
+// prebuilt provider's mask is when the provider was built against another C++
+// standard library (flutter_edge_ai, patch_c_api.sh section 26). Its members
+// must not be read; only its virtual Apply may be called.
+class ForeignBitmapMask : public LogitMask {
+ public:
+  explicit ForeignBitmapMask(int allowed_token) : allowed_token_(allowed_token) {}
+  MaskType GetType() const override { return MaskType::kBitmap; }
+  absl::Status Apply(absl::Span<float> logits) const override {
+    return ApplyImpl(logits, -std::numeric_limits<float>::infinity());
+  }
+  absl::Status Apply(absl::Span<tflite::half> logits) const override {
+    return ApplyImpl(logits, tflite::half::min());
+  }
+
+ private:
+  template <typename T>
+  absl::Status ApplyImpl(absl::Span<T> logits, T disallowed) const {
+    for (int i = 0; i < static_cast<int>(logits.size()); ++i) {
+      if (i != allowed_token_) logits[i] = disallowed;
+    }
+    return absl::OkStatus();
+  }
+
+  // Deliberately not BitmapLogitMask's layout: a static_cast reading its
+  // vocab_size() or words() reads these bytes instead.
+  const int allowed_token_;
+  const uint64_t not_a_word_vector_[3] = {0, 0x2003, 0x2003};
+};
+
+class ForeignBitmapConstraint : public FakeConstraint {
+ public:
+  ForeignBitmapConstraint(int allowed_token, int vocabulary_size)
+      : FakeConstraint(/*token_ids=*/{allowed_token, 1}, vocabulary_size),
+        allowed_token_(allowed_token) {}
+  absl::StatusOr<std::unique_ptr<LogitMask>> ComputeMask(
+      const State&) const override {
+    return std::make_unique<ForeignBitmapMask>(allowed_token_);
+  }
+
+ private:
+  const int allowed_token_;
+};
+
+TEST(ThinkingBudgetConstraintTest, TestStepZeroUsesUserBitmapMaskOnlyByApply) {
+  ForeignBitmapConstraint user_constraint(/*allowed_token=*/7,
+                                          /*vocabulary_size=*/16);
+  ThinkingBudgetConstraint constraint(&user_constraint, /*budget=*/5,
+                                      /*start_token_ids=*/{2, 3},
+                                      /*end_token_ids=*/{4},
+                                      /*vocab_size=*/16);
+
+  auto state = constraint.Start();
+  ASSERT_OK_AND_ASSIGN(auto mask, constraint.ComputeMask(*state));
+  EXPECT_EQ(mask->GetType(), MaskType::kCustom);
+  EXPECT_THAT(AllowedTokens(constraint, *state), ElementsAre(2, 7));
+
+  std::vector<tflite::half> half_logits(16, static_cast<tflite::half>(1.0f));
+  ASSERT_OK(mask->Apply(absl::MakeSpan(half_logits)));
+  for (int i = 0; i < 16; ++i) {
+    if (i == 2 || i == 7) {
+      EXPECT_FLOAT_EQ(static_cast<float>(half_logits[i]), 1.0f) << i;
+    } else {
+      EXPECT_FLOAT_EQ(static_cast<float>(half_logits[i]),
+                      static_cast<float>(tflite::half::min()))
+          << i;
+    }
+  }
+}
