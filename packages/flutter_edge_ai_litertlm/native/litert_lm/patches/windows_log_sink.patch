+++ b/c/windows_log_sink.cc
@@ -0,0 +1,73 @@
+// flutter_gemma patch (section 17): LiteRT-LM's log on Windows.
+//
+// LiteRtLm.dll links the C runtime statically, and the stderr of that copy of
+// the runtime reaches neither a file nor a console in a Flutter Windows app,
+// even when the process starts with stderr redirected: absl wrote nothing, an
+// ERROR line included, while the Intel dispatch DLL's lines arrived (Panther
+// Lake, native-v0.18.0-f). This sink writes each absl line to the process's
+// own standard error handle and to an attached debugger, at the threshold
+// litert_lm_set_min_log_level set. absl's own stderr output is turned off
+// while the sink is installed, so no line is written twice.
+
+#if defined(_WIN32)
+
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+
+#include <atomic>
+#include <string>
+
+#include "absl/base/log_severity.h"  // from @com_google_absl
+#include "absl/log/globals.h"  // from @com_google_absl
+#include "absl/log/log_entry.h"  // from @com_google_absl
+#include "absl/log/log_sink.h"  // from @com_google_absl
+#include "absl/log/log_sink_registry.h"  // from @com_google_absl
+#include "absl/strings/string_view.h"  // from @com_google_absl
+
+namespace litert::lm::c {
+namespace {
+
+std::atomic<int> g_threshold{
+    static_cast<int>(absl::LogSeverityAtLeast::kInfinity)};
+
+class WindowsStderrSink : public absl::LogSink {
+ public:
+  void Send(const absl::LogEntry& entry) override {
+    if (static_cast<int>(entry.log_severity()) <
+        g_threshold.load(std::memory_order_relaxed)) {
+      return;
+    }
+    const absl::string_view text = entry.text_message_with_prefix_and_newline();
+    const HANDLE out = GetStdHandle(STD_ERROR_HANDLE);
+    if (out != nullptr && out != INVALID_HANDLE_VALUE) {
+      DWORD written = 0;
+      WriteFile(out, text.data(), static_cast<DWORD>(text.size()), &written,
+                nullptr);
+    }
+    const std::string line(text);
+    OutputDebugStringA(line.c_str());
+  }
+};
+
+}  // namespace
+
+void InstallWindowsStderrLogSink() {
+  static WindowsStderrSink* const sink = [] {
+    auto* created = new WindowsStderrSink();
+    absl::AddLogSink(created);
+    return created;
+  }();
+  (void)sink;
+  g_threshold.store(static_cast<int>(absl::StderrThreshold()),
+                    std::memory_order_relaxed);
+  absl::SetStderrThreshold(absl::LogSeverityAtLeast::kInfinity);
+}
+
+}  // namespace litert::lm::c
+
+#endif  // defined(_WIN32)
