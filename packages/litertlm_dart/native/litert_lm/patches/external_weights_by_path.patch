 ModelResourcesLitertLm::GetWeightsSectionOffset(
     absl::string_view model_type_str) {
+#if LITERT_LM_PATH_WEIGHTS
+  // flutter_gemma patch (section 13): GetTFLiteModel addressed the weights by
+  // path. NotFound makes GetExternalWeightResources hand no ScopedWeightSource
+  // to SetExternalWeightScopedFile, whose C++ map the runtime library must not
+  // receive from this one.
+  (void)model_type_str;
+  return absl::NotFoundError(
+      "TFLiteWeights are addressed by path (flutter_gemma patch section 13)");
+#else
   return litert_lm_loader_->GetSectionLocation(
       BufferKey(schema::AnySectionDataType_TFLiteWeights, model_type_str));
+#endif  // LITERT_LM_PATH_WEIGHTS
 }
 
