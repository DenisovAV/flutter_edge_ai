     return absl::NotFoundError(absl::StrCat(key, " not found in the model."));
   }
 
+#if LITERT_LM_PATH_WEIGHTS
+  // flutter_gemma patch (section 13): the runtime reads this model's external
+  // weights by path, so no ScopedWeightSource crosses into it (see
+  // external_weights_by_path.h). Errors are returned, never retried through
+  // the scoped file.
+  auto weights_section = litert_lm_loader_->GetSectionLocation(
+      BufferKey(schema::AnySectionDataType_TFLiteWeights, key));
+  if (weights_section.ok()) {
+    ABSL_ASSIGN_OR_RETURN(litert::BufferRef<uint8_t> section,
+                          GetTFLiteModelSectionBuffer(key));
+    LITERT_ASSIGN_OR_RETURN(auto bundle, litert_lm_loader_->GetScopedFile());
+    LITERT_ASSIGN_OR_RETURN(
+        auto addressed,
+        external_weights_by_path::AddressWeightsByPath(
+            absl::MakeConstSpan(section.Data(), section.Size()), bundle.get(),
+            weights_section->first,
+            weights_section->second - weights_section->first));
+    if (addressed.has_value()) {
+      auto owned =
+          std::make_unique<external_weights_by_path::PathAddressedModel>(
+              std::move(*addressed));
+      ABSL_ASSIGN_OR_RETURN(auto model,
+                            CreateLiteRtModelFromBuffer(owned->flatbuffer));
+      path_addressed_models_[key] = std::move(owned);
+      auto model_ptr = std::make_unique<litert::Model>(std::move(model));
+      auto* raw_model_ptr = model_ptr.get();
+      model_map_[key] = std::move(model_ptr);
+      return raw_model_ptr;
+    }
+  }
+#endif  // LITERT_LM_PATH_WEIGHTS
+
   if (enable_file_backed_model_loading_) {
