+namespace {
+// flutter_edge_ai (native-v0.19.1-d, patch_c_api.sh section 28): the OpenCL
+// work-group limit every GpuModel built in this process uses, once a kernel's
+// work group did not fit what the driver allows for the compiled kernel
+// (CL_KERNEL_WORK_GROUP_SIZE). 0 = the device's own limit. Only lowered.
+std::atomic<int> g_kernel_work_group_cap{0};
+// Program-cache entries (cache file, key) refused by that check in this
+// process: a later build skips the restore and overwrites the entry (Insert
+// updates a key), so an engine created again starts clean.
+std::mutex g_skip_restore_mutex;
+using CacheEntryId = std::pair<std::string, uint64_t>;  // (cache, key)
+absl::flat_hash_set<CacheEntryId>& SkipRestoreKeys() {
+  static auto* keys = new absl::flat_hash_set<CacheEntryId>();
+  return *keys;
+}
+// What this thread's current engine-create attempt found
+// (litert_lm_engine_create creates the engine on this thread): kLimitLowered =
+// the limit is now below the one the attempt started with, whoever lowered
+// it; kEntryRefused = a program-cache entry was refused. And the limit the
+// attempt started with.
+constexpr int kLimitLowered = 1;
+constexpr int kEntryRefused = 2;
+thread_local int t_kernel_work_group_recorded = 0;
+thread_local int t_attempt_cap = 0;
+// Entries refused during the current engine create (all its attempts): a
+// refusal counts as progress only the first time, so the retry loop ends.
+thread_local absl::flat_hash_set<CacheEntryId> t_refused_this_create;
+}  // namespace
+
+// Called by litert_lm_engine_create around each attempt; linked into
+// libLiteRtLm, hidden.
+extern "C" FLUTTER_EDGE_AI_HIDDEN int flutter_edge_ai_kernel_work_group_cap() {
+  return g_kernel_work_group_cap.load(std::memory_order_acquire);
+}
+extern "C" FLUTTER_EDGE_AI_HIDDEN void
+flutter_edge_ai_kernel_work_group_begin_create() {
+  t_refused_this_create.clear();
+}
+extern "C" FLUTTER_EDGE_AI_HIDDEN void
+flutter_edge_ai_kernel_work_group_begin_attempt() {
+  t_kernel_work_group_recorded = 0;
+  t_attempt_cap = g_kernel_work_group_cap.load(std::memory_order_acquire);
+}
+// Bit 1: the limit is now below the one the attempt started with; bit 2: a
+// program-cache entry not refused before in this create was refused. 0:
+// nothing an engine create again would change.
+extern "C" FLUTTER_EDGE_AI_HIDDEN int
+flutter_edge_ai_kernel_work_group_recorded() {
+  return t_kernel_work_group_recorded;
+}
+
 namespace litert::ml_drift {
 namespace {
+// flutter_edge_ai (native-v0.19.1-d): the smallest CL_KERNEL_WORK_GROUP_SIZE
+// among the kernels whose work group did not fit, from the payload ML Drift's
+// OpenCL InferenceContext puts on its status; 0 for any other status.
+int KernelWorkGroupLimit(const absl::Status& status) {
+  if (status.ok()) return 0;
+  const auto payload =
+      status.GetPayload(::ml_drift::kKernelWorkGroupLimitPayload);
+  int limit = 0;
+  if (!payload.has_value() ||
+      !absl::SimpleAtoi(std::string(*payload), &limit)) {
+    return 0;
+  }
+  return limit;
+}
+
+// Lowers the process-wide limit to the largest power of two that fits the
+// smallest kernel that did not (never below 64: some ops cannot lay out a
+// smaller work group, mean_stddev_normalization computes x = 0 under 32). The
+// GpuModel is not rebuilt here, since GraphToGpuModel cannot run twice on one
+// graph; the engine is created once more (litert_lm_engine_create).
+void RecordKernelWorkGroupLimit(const absl::Status& status) {
+  constexpr int kMinKernelWorkGroupCap = 64;
+  const int limit = KernelWorkGroupLimit(status);
+  if (limit < kMinKernelWorkGroupCap) return;
+  int cap = 1;
+  while (cap * 2 <= limit) cap *= 2;
+  int current = g_kernel_work_group_cap.load(std::memory_order_acquire);
+  bool lowered_here = false;
+  while (current == 0 || cap < current) {
+    if (g_kernel_work_group_cap.compare_exchange_weak(
+            current, cap, std::memory_order_acq_rel)) {
+      lowered_here = true;
+      break;
+    }
+  }
+  // A concurrent create may have lowered it first: what matters is that the
+  // limit is now below the one this attempt was built with.
+  const int now = g_kernel_work_group_cap.load(std::memory_order_acquire);
+  if (now > 0 && (t_attempt_cap == 0 || now < t_attempt_cap)) {
+    t_kernel_work_group_recorded |= kLimitLowered;
+  }
+  ABSL_LOG(WARNING) << status.message()
+                    << (lowered_here
+                            ? ". OpenCL work groups in this process are now "
+                              "limited to "
+                            : ". OpenCL work groups in this process are "
+                              "already limited to ")
+                    << now << " work items.";
+}
+
+bool RestoreSkipped(const CacheEntryId& entry) {
+  std::lock_guard<std::mutex> lock(g_skip_restore_mutex);
+  return SkipRestoreKeys().contains(entry);
+}
+
+void StopSkippingRestore(const CacheEntryId& entry) {
+  std::lock_guard<std::mutex> lock(g_skip_restore_mutex);
+  SkipRestoreKeys().erase(entry);
+}
+
+// A program-cache entry whose kernels do not fit (written before the limit was
+// lowered): record the limit, skip the entry until a rebuild of it is stored,
+// and fail this engine create, so the next attempt starts from a clean engine
+// instead of keeping the refused restore's allocations.
+absl::Status RefuseRestoredEntry(const CacheEntryId& entry,
+                                 const absl::Status& status) {
+  RecordKernelWorkGroupLimit(status);
+  {
+    std::lock_guard<std::mutex> lock(g_skip_restore_mutex);
+    SkipRestoreKeys().insert(entry);
+  }
+  if (t_refused_this_create.insert(entry).second) {
+    t_kernel_work_group_recorded |= kEntryRefused;
+  }
+  ABSL_LOG(WARNING) << "Refusing a program-cache entry whose kernels do not "
+                       "fit the driver's work-group limit; it is rebuilt.";
+  return status;
+}
+
+// Identifies the program-cache file a delegate reads, so a refused entry of
+// one cache never makes another skip the same key.
+std::string ProgramCacheIdentity(int fd, absl::string_view directory,
+                                 absl::string_view model_token) {
+#if !defined(_WIN32)
+  if (fd > 0) {
+    struct stat st;
+    if (fstat(fd, &st) == 0) {
+      return absl::StrCat("fd:", st.st_dev, ":", st.st_ino);
+    }
+    return absl::StrCat("fd:", fd);
+  }
+#else
+  if (fd > 0) return absl::StrCat("fd:", fd);
+#endif
+  return absl::StrCat(directory, "/", model_token);
+}
+
+// The device's GpuInfo with the process-wide OpenCL work-group limit, so ops
+// that write their work group into the kernel source pick a smaller one.
+absl::StatusOr<::ml_drift::GpuInfo> GetInfoWithKernelWorkGroupCap(
+    GpuBackend* backend) {
+  ABSL_ASSIGN_OR_RETURN(::ml_drift::GpuInfo gpu_info, backend->GetInfo());
+  const int cap = g_kernel_work_group_cap.load(std::memory_order_acquire);
+  if (cap > 0 && gpu_info.IsApiOpenCl()) {
+    int& total = gpu_info.opencl_info.max_work_group_total_size;
+    total = total > 0 ? std::min(total, cap) : cap;
+  }
+  return gpu_info;
+}
