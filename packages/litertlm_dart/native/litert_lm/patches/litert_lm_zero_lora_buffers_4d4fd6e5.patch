@@ -928,6 +928,12 @@ absl::Status LlmLiteRtCompiledModelExecutorBase::RunSignature(
     absl::flat_hash_map<absl::string_view, TensorBuffer>& input_buffers,
     absl::flat_hash_map<absl::string_view, TensorBuffer>& output_buffers,
     bool async) {
+  // Tracks whether the internal-only LoRA manager bound an active adapter so
+  // OSS builds (where the block below is stripped) still bind zero buffers.
+  bool bound_active_lora = false;
+  if (!bound_active_lora) {
