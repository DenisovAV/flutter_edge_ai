+// LoRA data whose every tensor is zero, sized from the model's own LoRA inputs:
+// bound for a session without an adapter on a model exported with LoRA inputs,
+// it leaves the base weights unchanged (W + 0). LoRA::Create refuses data that
+// matches none of the inputs, so the zeros are real tensors, not missing ones
+// (flutter_edge_ai section 33).
+class ZeroLoraData : public LoraData {
+ public:
+  explicit ZeroLoraData(absl::flat_hash_map<std::string, size_t> sizes)
+      : sizes_(std::move(sizes)) {}
+  absl::StatusOr<int> GetLoRARank() override {
+    return absl::UnimplementedError("The zero LoRA has no rank.");
+  }
+  absl::StatusOr<std::unique_ptr<BufferRef<uint8_t>>> ReadTensor(
+      absl::string_view name) override {
+    auto it = sizes_.find(name);
+    if (it == sizes_.end()) {
+      return absl::NotFoundError(absl::StrCat("No LoRA tensor ", name));
+    }
+    auto buffer = std::make_unique<OwningBufferRef<uint8_t>>(it->second);
+    std::memset(buffer->Data(), 0, it->second);
+    return buffer;
+  }
+  bool HasTensor(absl::string_view name) const override {
+    return sizes_.contains(name);
+  }
+  std::vector<std::string> GetAllTensorNames() const override {
+    std::vector<std::string> names;
+    names.reserve(sizes_.size());
+    for (const auto& [name, size] : sizes_) names.push_back(name);
+    return names;
+  }
+
+ private:
+  absl::flat_hash_map<std::string, size_t> sizes_;
+};
