+// Text LoRA sessions (flutter_edge_ai section 33, after LiteRT-LM PR #2508).
+// Records the LoRA calls the resource manager makes on its executor.
+class LoraRecordingFakeLlmExecutor : public FakeLlmExecutor {
+ public:
+  explicit LoraRecordingFakeLlmExecutor(absl::Status load_status = absl::OkStatus())
+      : FakeLlmExecutor(/*vocab_size=*/16, /*prefill_tokens_set=*/{},
+                        /*decode_tokens_set=*/{}),
+        load_status_(std::move(load_status)) {}
+
+  absl::Status LoadLoRA(uint32_t lora_id,
+                        const ModelAssets& model_assets) override {
+    if (!load_status_.ok()) return load_status_;
+    loaded_lora_ids_.push_back(lora_id);
+    return absl::OkStatus();
+  }
+  absl::Status UseLoRA(std::optional<uint32_t> lora_id) override {
+    used_lora_ids_.push_back(lora_id);
+    return absl::OkStatus();
+  }
+  absl::StatusOr<std::unique_ptr<LlmContext>> CreateNewContext(
+      std::optional<uint32_t> lora_id,
+      RuntimeConfig runtime_config) const override {
+    created_lora_ids_.push_back(lora_id);
+    auto processed_context = std::make_unique<FakeProcessedContext>();
+    processed_context->set_lora_id(lora_id);
+    return std::make_unique<LlmContext>(
+        std::move(processed_context),
+        std::make_unique<RuntimeConfig>(std::move(runtime_config)),
+        std::make_unique<RuntimeState>());
+  }
+  using FakeLlmExecutor::RestoreContext;
+  absl::Status RestoreContext(
+      std::unique_ptr<LlmContext> llm_context) override {
+    used_lora_ids_.push_back(llm_context->processed_context().lora_id());
+    return FakeLlmExecutor::RestoreContext(std::move(llm_context));
+  }
+
+  const std::vector<uint32_t>& loaded_lora_ids() const {
+    return loaded_lora_ids_;
+  }
+  const std::vector<std::optional<uint32_t>>& used_lora_ids() const {
+    return used_lora_ids_;
+  }
+  const std::vector<std::optional<uint32_t>>& created_lora_ids() const {
+    return created_lora_ids_;
+  }
+
+ private:
+  absl::Status load_status_;
+  std::vector<uint32_t> loaded_lora_ids_;
+  std::vector<std::optional<uint32_t>> used_lora_ids_;
+  mutable std::vector<std::optional<uint32_t>> created_lora_ids_;
+};
+
+std::string CreateTempLoraFile(const std::string& name) {
+  const std::string path = ::testing::TempDir() + "/" + name;
+  std::ofstream(path) << "lora";
+  return path;
+}
+
+absl::Status SetLoraFile(SessionConfig& session_config,
+                         const std::string& path) {
+  auto file = ScopedFile::Open(path);
+  if (!file.ok()) return file.status();
+  session_config.SetScopedLoraFile(
+      std::make_shared<ScopedFile>(std::move(*file)));
+  session_config.SetLoraPath(path);
+  return absl::OkStatus();
+}
+
+TEST(ResourceManagerLoraTest, CreateContextHandlerLoadsTextLora) {
+  auto executor = std::make_unique<LoraRecordingFakeLlmExecutor>();
+  LoraRecordingFakeLlmExecutor* executor_ptr = executor.get();
+  ASSERT_OK_AND_ASSIGN(
+      auto resource_manager,
+      ResourceManager::Create(/*model_resources=*/nullptr, std::move(executor),
+                              /*vision_executor_settings=*/nullptr,
+                              /*audio_executor_settings=*/nullptr,
+                              /*litert_env=*/nullptr));
+  SessionConfig session_config = SessionConfig::CreateDefault();
+  ASSERT_OK(SetLoraFile(session_config, CreateTempLoraFile("text_lora.tflite")));
+
+  ASSERT_OK_AND_ASSIGN(auto context_handler,
+                       resource_manager->CreateContextHandler(session_config));
+
+  EXPECT_THAT(executor_ptr->loaded_lora_ids(), ElementsAre(0));
+  EXPECT_THAT(executor_ptr->created_lora_ids(), ElementsAre(0));
+
+  auto shared_handler =
+      std::shared_ptr<ContextHandler>(std::move(context_handler));
+  ASSERT_OK_AND_ASSIGN(
+      auto locked_executor,
+      resource_manager->AcquireExecutorWithContextHandler(shared_handler));
+  ASSERT_FALSE(executor_ptr->used_lora_ids().empty());
+  EXPECT_EQ(executor_ptr->used_lora_ids().back(), std::optional<uint32_t>(0));
+}
+
+TEST(ResourceManagerLoraTest, SameLoraFileIsLoadedOnce) {
+  auto executor = std::make_unique<LoraRecordingFakeLlmExecutor>();
+  LoraRecordingFakeLlmExecutor* executor_ptr = executor.get();
+  ASSERT_OK_AND_ASSIGN(
+      auto resource_manager,
+      ResourceManager::Create(/*model_resources=*/nullptr, std::move(executor),
+                              /*vision_executor_settings=*/nullptr,
+                              /*audio_executor_settings=*/nullptr,
+                              /*litert_env=*/nullptr));
+  SessionConfig session_config = SessionConfig::CreateDefault();
+  ASSERT_OK(
+      SetLoraFile(session_config, CreateTempLoraFile("shared_lora.tflite")));
+
+  ASSERT_OK_AND_ASSIGN(auto first,
+                       resource_manager->CreateContextHandler(session_config));
+  ASSERT_OK_AND_ASSIGN(auto second,
+                       resource_manager->CreateContextHandler(session_config));
+
+  EXPECT_THAT(executor_ptr->loaded_lora_ids(), ElementsAre(0));
+  EXPECT_THAT(executor_ptr->created_lora_ids(), ElementsAre(0, 0));
+}
