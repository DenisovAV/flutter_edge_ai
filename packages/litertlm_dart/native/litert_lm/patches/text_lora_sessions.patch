+absl::StatusOr<bool> LlmLiteRtCompiledModelExecutorBase::SignatureHasLoraInputs(
+    absl::string_view signature) {
+  auto it = signature_has_lora_inputs_.find(signature);
+  if (it != signature_has_lora_inputs_.end()) return it->second;
+  LITERT_ASSIGN_OR_RETURN(auto input_names,
+                          compiled_model_->GetSignatureInputNames(signature));
+  bool has_lora = false;
+  for (const auto& input_name : input_names) {
+    if (IsLoRAInputName(input_name)) {
+      has_lora = true;
+      break;
+    }
+  }
+  signature_has_lora_inputs_.emplace(std::string(signature), has_lora);
+  return has_lora;
+}
+
+absl::Status LlmLiteRtCompiledModelExecutorBase::AppendLoraInputBuffers(
+    absl::string_view signature,
+    absl::flat_hash_map<absl::string_view, TensorBuffer>& input_buffers) {
+  ABSL_ASSIGN_OR_RETURN(const bool has_lora, SignatureHasLoraInputs(signature));
+  if (!has_lora) {
+    if (active_lora_id_.has_value()) {
+      return absl::FailedPreconditionError(absl::StrCat(
+          "A LoRA is active, but signature '", signature,
+          "' has no LoRA inputs: the model was not exported with LoRA "
+          "input signatures."));
+    }
+    return absl::OkStatus();
+  }
+  absl::flat_hash_map<absl::string_view, TensorBuffer> lora_buffers;
+  if (active_lora_id_.has_value()) {
+    RET_CHECK(lora_manager_ != nullptr)
+        << "LoRA manager is not initialized. Please load LoRA first.";
+    ABSL_ASSIGN_OR_RETURN(lora_buffers,
+                          lora_manager_->GetLoRABuffers(signature));
+  } else {
+    // A session without an adapter on a model with LoRA inputs: bind zeros,
+    // i.e. the base weights (W + 0).
+    if (zero_lora_ == nullptr) {
+      LITERT_ASSIGN_OR_RETURN(
+          auto decode_inputs,
+          compiled_model_->GetSignatureInputNames(kDecodeSignatureRunner));
+      absl::flat_hash_map<std::string, size_t> sizes;
+      for (const auto& input_name : decode_inputs) {
+        if (!IsLoRAInputName(input_name)) continue;
+        LITERT_ASSIGN_OR_RETURN(
+            TensorBuffer buffer,
+            compiled_model_->CreateInputBuffer(kDecodeSignatureRunner,
+                                               input_name));
+        LITERT_ASSIGN_OR_RETURN(size_t size, buffer.PackedSize());
+        sizes.emplace(std::string(input_name), size);
+      }
+      ABSL_ASSIGN_OR_RETURN(
+          zero_lora_,
+          LoRA::Create(std::make_unique<ZeroLoraData>(std::move(sizes)),
+                       *compiled_model_, kDecodeSignatureRunner));
+    }
+    ABSL_ASSIGN_OR_RETURN(lora_buffers, zero_lora_->GetLoRABuffers(signature));
+  }
+  for (auto& [name, buffer] : lora_buffers) {
+    input_buffers.insert_or_assign(name, std::move(buffer));
+  }
+  return absl::OkStatus();
+}
