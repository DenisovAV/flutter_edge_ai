rules_version = '2';

// No browser reads or writes any document. Showcase submissions are written
// by the submitShowcaseApp function (functions/), whose Admin SDK bypasses
// these rules, and read by the owner from the console or with
// tool/showcase_submissions.dart.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
